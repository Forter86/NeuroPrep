# Базовый URL или полный URL upstream API.
# Если это base URL, gateway может ходить в /completions (см. /api/ai/completions).
# Пусто = демо-ответы без внешнего API.
NEUROPREP_API_URL=

# Если бэкенд требует ключ — только на сервере, в браузер не попадает.
NEUROPREP_API_KEY=

# Список моделей для /api/ai/models (через запятую).
NEUROPREP_MODELS=demo-safety-tutor

# --- Database (MySQL / MariaDB) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://user:password@host:3306/LabPro

# --- Auth ---
# local = проверка логина/пароля по БД, keycloak = делегирование в Keycloak (OIDC)
AUTH_MODE=local
# Секрет для подписи наших JWT (HS256). Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=neuroprep
JWT_AUDIENCE=neuroprep-app

# --- Keycloak (для AUTH_MODE=keycloak) ---
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
